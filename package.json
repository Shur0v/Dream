{
  "name": "dream",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "backend:dev": "nodemon --exec ts-node backend/server.ts",
    "backend:build": "tsc --project backend/tsconfig.json",
    "backend:start": "node backend/dist/server.js",
    "dev:all": "concurrently \"pnpm backend:dev\" \"pnpm dev\"",
    "security:update": "pnpm install next@15.5.7 react@19.2.3 react-dom@19.2.3 @types/react@latest @types/react-dom@latest --save-exact",
    "security:verify": "pnpm list next react react-dom",
    "migrate:mongodb": "ts-node backend/scripts/migrate-to-mongodb.ts",
    "verify:mongodb": "ts-node backend/lib/db-verify.ts",
    "scan:base64": "ts-node backend/scripts/scan-base64-images.ts",
    "migrate:images": "ts-node backend/scripts/migrate-base64-to-cloudinary.ts",
    "verify:images": "ts-node backend/scripts/verify-all-images-cdn.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.0.1",
    "@upstash/redis": "^1.35.6",
    "@vercel/blob": "^2.0.0",
    "axios": "^1.6.2",
    "cloudinary": "^2.8.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.460.0",
    "mongoose": "^9.1.1",
    "next": "^15.5.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.66.0",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
